# Disposable LOCAL development settings. Deliberately tracked.
POSTGRES_DB=hackathon
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon_dev
POSTGRES_PORT=5432
DB_HOST=localhost
SERVER_PORT=8080
WISEEASE_DEMO_ENABLED=true
# Docker publishes Spring and the web app on the network so phones on the same Wi-Fi can reach them.
# Use 127.0.0.1 to keep them private to this computer. PostgreSQL always stays on 127.0.0.1.
BIND_ADDRESS=0.0.0.0
